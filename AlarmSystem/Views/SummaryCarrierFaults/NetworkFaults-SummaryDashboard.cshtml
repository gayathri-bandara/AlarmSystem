@model AlarmSystem.ViewModels.SummaryCarrierFaultViewModel

@{
    ViewData["Title"] = "Network Faults - Summary Dashboard";

    var summary = Model.Summary ?? new AlarmSystem.Models.CarrierSummaryModel();
    var details = Model.Details ?? new List<AlarmSystem.Models.SummaryCarrierFaultModel>();

    int totalFaults = summary.CEA + summary.MSAN + summary.SLBN;

    var platformLabels = new[] { "CEA", "MSAN", "SLBN" };
    var platformData = new[] { summary.CEA, summary.MSAN, summary.SLBN };

    var ageLabels = new[] { "<1 Day", "1-3 Days", "3-7 Days", ">7 Days" };

    var ceaAge = new[]
    {
        details.Sum(x => x.CEA_LT1D),
        details.Sum(x => x.CEA_1D_3D),
        details.Sum(x => x.CEA_3D_7D),
        details.Sum(x => x.CEA_GT7D)
    };

    var msanAge = new[]
    {
        details.Sum(x => x.MSAN_LT1D),
        details.Sum(x => x.MSAN_1D_3D),
        details.Sum(x => x.MSAN_3D_7D),
        details.Sum(x => x.MSAN_GT7D)
    };

    var slbnAge = new[]
    {
        details.Sum(x => x.SLBN_LT1D),
        details.Sum(x => x.SLBN_1D_3D),
        details.Sum(x => x.SLBN_3D_7D),
        details.Sum(x => x.SLBN_GT7D)
    };

    var ageTotals = new[]
    {
        ceaAge[0] + msanAge[0] + slbnAge[0],
        ceaAge[1] + msanAge[1] + slbnAge[1],
        ceaAge[2] + msanAge[2] + slbnAge[2],
        ceaAge[3] + msanAge[3] + slbnAge[3]
    };

    Func<AlarmSystem.Models.SummaryCarrierFaultModel, int> rowTotal = x =>
        x.CEA_LT1D + x.CEA_1D_3D + x.CEA_3D_7D + x.CEA_GT7D +
        x.MSAN_LT1D + x.MSAN_1D_3D + x.MSAN_3D_7D + x.MSAN_GT7D +
        x.SLBN_LT1D + x.SLBN_1D_3D + x.SLBN_3D_7D + x.SLBN_GT7D;

    var regionTotals = details
        .GroupBy(x => string.IsNullOrWhiteSpace(x.REGION) ? "UNKNOWN" : x.REGION)
        .Select(g => new {
            Region = g.Key,
            Total  = g.Sum(rowTotal),
            Districts = g.Select(r => r.PROVINCE?.Trim())
                .Where(district => !string.IsNullOrWhiteSpace(district))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(district => district, StringComparer.OrdinalIgnoreCase)
                .ToArray(),
            CEA    = g.Sum(r => r.CEA_LT1D + r.CEA_1D_3D + r.CEA_3D_7D + r.CEA_GT7D),
            MSAN   = g.Sum(r => r.MSAN_LT1D + r.MSAN_1D_3D + r.MSAN_3D_7D + r.MSAN_GT7D),
            SLBN   = g.Sum(r => r.SLBN_LT1D + r.SLBN_1D_3D + r.SLBN_3D_7D + r.SLBN_GT7D),
            GT7D   = g.Sum(r => r.CEA_GT7D + r.MSAN_GT7D + r.SLBN_GT7D),
            LT1D   = g.Sum(r => r.CEA_LT1D + r.MSAN_LT1D + r.SLBN_LT1D)
        })
        .OrderByDescending(x => x.Total)
        .Take(10)
        .ToList();

    var trend = Model.Trend ?? new List<AlarmSystem.Models.FaultTrendModel>();

    var trendDates = trend.Select(x => x.Date.ToString("dd-MMM")).ToArray();
    var trendCea   = trend.Select(x => x.CEA).ToArray();
    var trendMsan  = trend.Select(x => x.MSAN).ToArray();
    var trendSlbn  = trend.Select(x => x.SLBN).ToArray();
    var trendTotal = trend.Select(x => x.Total).ToArray();

    var cumulativeTotal = new List<int>();
    {
        int running = 0;
        foreach (var t in trend) { running += t.Total; cumulativeTotal.Add(running); }
    }

    string trendDateRange = trend.Any()
        ? $"{trend.First().Date:dd-MMM-yyyy} \u2192 {trend.Last().Date:dd-MMM-yyyy}"
        : "No data";
    int trendSpanDays = trend.Any() ? Math.Max(1,(trend.Last().Date - trend.First().Date).Days + 1) : 0;
    double avgPerDay  = trendSpanDays > 0 ? Math.Round((double)trend.Sum(x => x.Total) / trendSpanDays, 1) : 0.0;

    string peakDayText = "\u2014";
    var peakPoint = trend.OrderByDescending(x => x.Total).FirstOrDefault();
    if (peakPoint != null) peakDayText = $"{peakPoint.Total} on {peakPoint.Date:dd-MMM}";

    int recent7Sum   = trend.Count >= 7  ? trend.Skip(trend.Count - 7).Sum(x => x.Total)  : (trend.Any() ? trend.Sum(x => x.Total) : 0);
    int previous7Sum = trend.Count >= 14 ? trend.Skip(trend.Count - 14).Take(7).Sum(x => x.Total) : 0;

    string trendDirectionText  = "\u2014";
    string trendDirectionClass = "trend-stable";
    if (previous7Sum > 0)
    {
        double pctChange = Math.Round(((double)(recent7Sum - previous7Sum) / previous7Sum) * 100, 0);
        if      (pctChange > 0) { trendDirectionText = $"\u25B2 +{pctChange}% (rising)";   trendDirectionClass = "trend-up"; }
        else if (pctChange < 0) { trendDirectionText = $"\u25BC {pctChange}% (declining)"; trendDirectionClass = "trend-down"; }
        else                    { trendDirectionText = "\u2192 Stable";                     trendDirectionClass = "trend-stable"; }
    }
    else if (recent7Sum > 0) { trendDirectionText = "\u25B2 New activity"; trendDirectionClass = "trend-up"; }

    var chartPayload = new
    {
        platformLabels, platformData, ageLabels,
        ageData = ageTotals, ceaAge, msanAge, slbnAge,
        regionLabels  = regionTotals.Select(x => x.Region).ToArray(),
        regionData    = regionTotals.Select(x => x.Total).ToArray(),
        regionDistricts = regionTotals.Select(x => x.Districts).ToArray(),
        regionCea     = regionTotals.Select(x => x.CEA).ToArray(),
        regionMsan    = regionTotals.Select(x => x.MSAN).ToArray(),
        regionSlbn    = regionTotals.Select(x => x.SLBN).ToArray(),
        regionGt7d    = regionTotals.Select(x => x.GT7D).ToArray(),
        regionLt1d    = regionTotals.Select(x => x.LT1D).ToArray(),
        totalFaults,
        trendDates, trendCea, trendMsan, trendSlbn, trendTotal,
        cumulativeTotal = cumulativeTotal.ToArray()
    };
}

<style>
    /* =====================================================
       BASE
    ===================================================== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: #e8edf5;
        background-image:
            radial-gradient(ellipse at 8% 0%,  rgba(0,48,135,.08)  0%, transparent 50%),
            radial-gradient(ellipse at 92% 100%,rgba(0,194,255,.06) 0%, transparent 50%);
        min-height: 100vh;
    }

    .db-wrap {
        padding: 10px 12px 16px;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* =====================================================
       HEADER
    ===================================================== */
    .db-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(110deg, #001a5c 0%, #003087 32%, #1A56DB 70%, #00C2FF 100%);
        border-radius: 14px;
        padding: 13px 18px;
        margin-bottom: 10px;
        box-shadow: 0 6px 24px rgba(0,48,135,.30), inset 0 1px 0 rgba(255,255,255,.12);
        position: relative;
        overflow: hidden;
    }
    .db-header::before {
        content: '';
        position: absolute; top: -50px; right: -50px;
        width: 180px; height: 180px; border-radius: 50%;
        background: rgba(255,255,255,.06);
    }
    .db-header::after {
        content: '';
        position: absolute; bottom: -60px; left: 28%;
        width: 240px; height: 240px; border-radius: 50%;
        background: rgba(0,194,255,.07);
    }
    .db-header-left { position: relative; z-index: 1; }

    .db-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 20px;
        padding: 2px 10px;
        font-size: 0.62rem;
        font-weight: 700;
        color: rgba(255,255,255,.9);
        letter-spacing: .5px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }
    .db-badge-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: #00D48C;
        animation: blink 2s infinite;
    }
    @@keyframes blink {
        0%,100% { opacity:1; transform:scale(1); }
        50%      { opacity:.4; transform:scale(1.4); }
    }

    .db-header-title {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: .4px;
        text-transform: uppercase;
    }
    .db-header-sub {
        color: rgba(255,255,255,.62);
        font-size: 0.68rem;
        margin-top: 2px;
        letter-spacing: .2px;
    }

    .btn-back {
        position: relative; z-index: 1;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 7px 15px;
        border-radius: 8px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.32);
        color: #fff;
        text-decoration: none;
        white-space: nowrap;
        transition: all .2s;
        backdrop-filter: blur(4px);
        letter-spacing: .2px;
    }
    .btn-back:hover { background: rgba(255,255,255,.24); color: #fff; transform: translateX(-2px); }

    /* =====================================================
       KPI STRIP
    ===================================================== */
    .kpi-strip {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 8px;
        margin-bottom: 10px;
    }
    .kpi {
        border-radius: 13px;
        padding: 12px 14px 11px;
        display: flex;
        align-items: center;
        gap: 13px;
        box-shadow: 0 4px 18px rgba(0,0,0,.13);
        position: relative;
        overflow: hidden;
        transition: transform .2s, box-shadow .2s;
    }
    .kpi:hover { transform: translateY(-3px); box-shadow: 0 8px 26px rgba(0,0,0,.18); }
    .kpi::before {
        content: '';
        position: absolute; inset: 0;
        background: linear-gradient(135deg,rgba(255,255,255,.13) 0%,transparent 55%);
        pointer-events: none;
    }
    .kpi::after {
        content: '';
        position: absolute; right: -22px; bottom: -22px;
        width: 88px; height: 88px; border-radius: 50%;
        background: rgba(255,255,255,.08);
    }
    .kpi-total { background: linear-gradient(135deg,#001a5c,#003087); }
    .kpi-cea   { background: linear-gradient(135deg,#007ab8,#00C2FF); }
    .kpi-msan  { background: linear-gradient(135deg,#009e68,#00D48C); }
    .kpi-slbn  { background: linear-gradient(135deg,#0f3a9e,#1A56DB); }

    .kpi-icon-wrap {
        width: 40px; height: 40px; border-radius: 11px;
        background: rgba(255,255,255,.18);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem; flex-shrink: 0;
        position: relative; z-index: 1;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.25);
    }
    .kpi-body { flex: 1; position: relative; z-index: 1; }
    .kpi-value {
        font-size: 1.9rem;
        font-weight: 900;
        color: #fff;
        line-height: 1;
        letter-spacing: -1px;
    }
    .kpi-label {
        font-size: 0.63rem;
        font-weight: 600;
        color: rgba(255,255,255,.75);
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-top: 3px;
    }

    /* =====================================================
       SECTION LABEL
    ===================================================== */
    .sec-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.67rem;
        font-weight: 800;
        color: #003087;
        text-transform: uppercase;
        letter-spacing: .9px;
        margin-bottom: 7px;
    }
    .sec-label::before {
        content: '';
        width: 3px; height: 15px;
        background: linear-gradient(180deg,#00C2FF,#003087);
        border-radius: 3px; flex-shrink: 0;
    }
    .sec-label::after {
        content: '';
        flex: 1; height: 1px;
        background: linear-gradient(90deg,#c5d0e8,transparent);
    }

    /* =====================================================
       CHART GRID & CARDS
    ===================================================== */
    .chart-grid {
        display: grid;
        grid-template-columns: repeat(12,1fr);
        gap: 8px;
        margin-bottom: 10px;
    }
    .cc {
        background: #fff;
        border-radius: 13px;
        padding: 10px 12px 9px;
        box-shadow: 0 2px 10px rgba(0,0,0,.07);
        border: 1px solid rgba(220,228,242,.9);
        transition: box-shadow .2s, transform .2s;
    }
    .cc:hover { box-shadow: 0 5px 20px rgba(0,0,0,.11); transform: translateY(-1px); }
    .cc-3  { grid-column: span 3; }
    .cc-4  { grid-column: span 4; }
    .cc-5  { grid-column: span 5; }
    .cc-7  { grid-column: span 7; }
    .cc-12 { grid-column: span 12; }

    .cc-head {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 7px;
        padding-bottom: 6px;
        border-bottom: 1px solid #f1f5fc;
    }
    .cc-dot {
        width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
        box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px currentColor;
    }
    .cc-title {
        font-size: 0.68rem;
        font-weight: 800;
        color: #334155;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .cbox    { position: relative; height: 175px; }
    .cbox-lg { position: relative; height: 220px; }
    .cbox-xl { position: relative; height: 265px; }

    /* =====================================================
       STATUS BREAKDOWN
    ===================================================== */
    .status-body {
        display: flex; flex-direction: column; gap: 12px;
        padding: 2px 0;
    }
    .sb-row { display: flex; flex-direction: column; gap: 3px; }
    .sb-top { display: flex; align-items: center; gap: 8px; }
    .sb-icon-wrap {
        width: 26px; height: 26px; border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.75rem; flex-shrink: 0;
    }
    .sb-label  { font-size: 0.74rem; font-weight: 700; color: #1e293b; flex: 1; }
    .sb-count  {
        font-size: 0.68rem; font-weight: 800; color: #fff;
        border-radius: 20px; padding: 2px 9px;
        min-width: 28px; text-align: center; letter-spacing: .2px;
    }
    .sb-sub    { font-size: 0.6rem; color: #94a3b8; padding-left: 34px; line-height: 1.3; }
    .sb-track-wrap { display: flex; align-items: center; gap: 7px; padding-left: 34px; }
    .sb-track  { flex: 1; height: 7px; background: #edf2fb; border-radius: 6px; overflow: hidden; }
    .sb-fill   {
        height: 100%; border-radius: 6px;
        transition: width .7s cubic-bezier(.4,0,.2,1);
        position: relative;
    }
    .sb-fill::after {
        content: '';
        position: absolute; inset: 0;
        background: linear-gradient(90deg,transparent,rgba(255,255,255,.35));
        border-radius: 6px;
    }
    .sb-pct    { font-size: 0.63rem; font-weight: 700; color: #64748b; min-width: 34px; text-align: right; }

    /* =====================================================
       MATRIX TABLE
    ===================================================== */
    .mx-wrap {
        border-radius: 13px; overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.07);
        border: 1px solid rgba(220,228,242,.9);
        margin-top: 7px;
    }
    .mx-table {
        width: 100%; font-size: 0.78rem; border-collapse: collapse; margin: 0;
    }
    .mx-table th, .mx-table td {
        text-align: center; vertical-align: middle;
        padding: 5px 7px; border: 1px solid #e2e8f0;
    }
    .mx-table thead th { color: #fff; font-weight: 700; font-size: 0.72rem; letter-spacing: .3px; }
    .mx-table th.th-age   { background: linear-gradient(135deg,#001a5c,#003087); }
    .mx-table th.th-cea   { background: linear-gradient(135deg,#0099d6,#00C2FF); }
    .mx-table th.th-msan  { background: linear-gradient(135deg,#009e68,#00D48C); }
    .mx-table th.th-slbn  { background: linear-gradient(135deg,#0f3a9e,#1A56DB); }
    .mx-table th.th-total { background: linear-gradient(135deg,#000d33,#001a5c); }
    .mx-table tfoot td    { background: #eef2fb; font-weight: 700; color: #003087; }
    .mx-table tbody tr:nth-child(even) { background: #f8faff; }
    .mx-table tbody tr:hover { background: #eef4ff; }

    /* =====================================================
       REGION INTERACTIVE TOOLTIP
    ===================================================== */
    #regionTooltip {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        background: #fff;
        border: 1px solid rgba(26,86,219,.18);
        border-radius: 12px;
        padding: 10px 12px;
        min-width: 210px;
        box-shadow: 0 8px 28px rgba(0,48,135,.18), 0 2px 8px rgba(0,0,0,.08);
        transition: opacity .15s ease;
        z-index: 9999;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }
    .rtt-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
        padding-bottom: 7px;
        border-bottom: 1px solid #eef2fb;
    }
    .rtt-region {
        font-size: 0.75rem;
        font-weight: 800;
        color: #003087;
        text-transform: uppercase;
        letter-spacing: .4px;
    }
    .rtt-total {
        font-size: 0.72rem;
        font-weight: 700;
        background: linear-gradient(135deg,#003087,#1A56DB);
        color: #fff;
        border-radius: 20px;
        padding: 2px 8px;
    }
    .rtt-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 5px;
    }
    .rtt-dot {
        width: 8px; height: 8px;
        border-radius: 50%; flex-shrink: 0;
    }
    .rtt-lbl {
        font-size: 0.68rem;
        font-weight: 700;
        color: #475569;
        min-width: 32px;
    }
    .rtt-bar-wrap {
        flex: 1;
        height: 6px;
        background: #eef2fb;
        border-radius: 4px;
        overflow: hidden;
    }
    .rtt-bar {
        display: block;
        height: 100%;
        border-radius: 4px;
        transition: width .3s ease;
    }
    .rtt-val {
        font-size: 0.72rem;
        font-weight: 800;
        color: #1e293b;
        min-width: 20px;
        text-align: right;
    }
    .rtt-divider {
        height: 1px;
        background: #eef2fb;
        margin: 6px 0;
    }
    .rtt-row-sm {
        justify-content: space-between;
        margin-bottom: 0;
    }
    .rtt-badge {
        font-size: 0.65rem;
        font-weight: 700;
        border-radius: 20px;
        padding: 2px 8px;
    }
    .rtt-new     { background: rgba(0,194,255,.12); color: #0088c7; }
    .rtt-stalled { background: rgba(244,63,94,.12); color: #d4163c; }
    .rtt-district-label {
        display: block;
        margin-bottom: 3px;
        color: #475569;
        font-size: 0.65rem;
        font-weight: 700;
    }
    .rtt-district-list {
        display: block;
        max-width: 260px;
        color: #1e293b;
        font-size: 0.68rem;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */
    @@media (max-width: 992px) {
        .kpi-strip { grid-template-columns: repeat(2,1fr); }
        .cc-4,.cc-5,.cc-7,.cc-12 { grid-column: span 12; }
    }
    @@media (max-width: 576px) {
        .kpi-strip { grid-template-columns: 1fr; }
        .cbox { height: 150px; }
        .cbox-lg { height: 190px; }
        .cbox-xl { height: 210px; }
        .db-header-title { font-size: .88rem; }
    }
</style>

<div class="db-wrap">

        <div class="db-header">
        <div class="db-header-left">
            <div class="db-badge"><span class="db-badge-dot"></span>Live Dashboard</div>
            <h2 class="db-header-title">Network Faults - Summary Dashboard</h2>
            <div class="db-header-sub">Node Down &nbsp;&bull;&nbsp; Open Faults &nbsp;&bull;&nbsp; CEA &middot; MSAN &middot; SLBN</div>
        </div>
        <a asp-action="Index" class="btn-back">&#8592; Back to Summary</a>
    </div>

        <div class="kpi-strip">
        <div class="kpi kpi-total">
            <div class="kpi-icon-wrap">&#9888;&#65039;</div>
            <div class="kpi-body">
                <div class="kpi-value">@totalFaults</div>
                <div class="kpi-label">Total Open Faults</div>
            </div>
        </div>
        <div class="kpi kpi-cea">
            <div class="kpi-icon-wrap">&#128246;</div>
            <div class="kpi-body">
                <div class="kpi-value">@summary.CEA</div>
                <div class="kpi-label">CEA &mdash; Customer Edge Access</div>
            </div>
        </div>
        <div class="kpi kpi-msan">
            <div class="kpi-icon-wrap">&#128225;</div>
            <div class="kpi-body">
                <div class="kpi-value">@summary.MSAN</div>
                <div class="kpi-label">MSAN &mdash; Multi-Service Access</div>
            </div>
        </div>
        <div class="kpi kpi-slbn">
            <div class="kpi-icon-wrap">&#127760;</div>
            <div class="kpi-body">
                <div class="kpi-value">@summary.SLBN</div>
                <div class="kpi-label">SLBN &mdash; SLT Backbone Node</div>
            </div>
        </div>
    </div>

        <div class="sec-label">Distribution &amp; Platform Analysis</div>
    <div class="chart-grid">
        <div class="cc cc-4">
            <div class="cc-head">
                <div class="cc-dot" style="background:#00C2FF;color:#00C2FF"></div>
                <span class="cc-title">Platform Distribution</span>
            </div>
            <div class="cbox"><canvas id="platformPieChart"></canvas></div>
        </div>
        <div class="cc cc-4">
            <div class="cc-head">
                <div class="cc-dot" style="background:#F59E0B;color:#F59E0B"></div>
                <span class="cc-title">Fault Age Distribution</span>
            </div>
            <div class="cbox"><canvas id="agePieChart"></canvas></div>
        </div>
        <div class="cc cc-4">
            <div class="cc-head">
                <div class="cc-dot" style="background:#1A56DB;color:#1A56DB"></div>
                <span class="cc-title">Faults by Platform &amp; Age Group</span>
            </div>
            <div class="cbox"><canvas id="platformAgeBarChart"></canvas></div>
        </div>
    </div>

        <div class="sec-label">Regional Impact &amp; Status Breakdown</div>
    <div class="chart-grid">
        <div class="cc cc-5">
            <div class="cc-head">
                <div class="cc-dot" style="background:#003087;color:#003087"></div>
                <span class="cc-title">Top Regions by Fault Count</span>
            </div>
            <div class="cbox-lg"><canvas id="regionBarChart"></canvas></div>
        </div>

        <div class="cc cc-4">
            <div class="cc-head">
                <div class="cc-dot" style="background:#00C2FF;color:#00C2FF"></div>
                <span class="cc-title">Regional Faults by Platform</span>
            </div>
            <div class="cbox-lg"><canvas id="regionPlatformBarChart"></canvas></div>
        </div>

        <div class="cc cc-3">
            <div class="cc-head">
                <div class="cc-dot" style="background:#F43F5E;color:#F43F5E"></div>
                <span class="cc-title">Status Breakdown</span>
            </div>
            <div class="status-body">
                @{
                    int sb_total = ageTotals.Sum();
                    var sb_items = new[]
                    {
                        new { Label = "Active / New",         Sub = "< 1 Day — Reported, being investigated",  Val = ageTotals[0], Color = "#00C2FF", Bg = "rgba(0,194,255,.13)",  Icon = "&#9654;" },
                        new { Label = "In Progress",          Sub = "1–3 Days — Under active work",            Val = ageTotals[1], Color = "#00D48C", Bg = "rgba(0,212,140,.13)",  Icon = "&#9881;" },
                        new { Label = "Pending Support",      Sub = "3–7 Days — Awaiting vendor / parts",      Val = ageTotals[2], Color = "#F59E0B", Bg = "rgba(245,158,11,.13)", Icon = "&#8987;" },
                        new { Label = "Stalled / Unassigned", Sub = "> 7 Days — Critical backlog",             Val = ageTotals[3], Color = "#F43F5E", Bg = "rgba(244,63,94,.13)",  Icon = "&#9888;" },
                    };
                }
                @foreach (var s in sb_items)
                {
                    double pct = sb_total > 0 ? Math.Round((double)s.Val / sb_total * 100, 1) : 0;
                    <div class="sb-row">
                        <div class="sb-top">
                            <div class="sb-icon-wrap" style="background:@s.Bg;color:@s.Color">@Html.Raw(s.Icon)</div>
                            <span class="sb-label">@s.Label</span>
                            <span class="sb-count" style="background:@s.Color">@s.Val</span>
                        </div>
                        <div class="sb-sub">@s.Sub</div>
                        <div class="sb-track-wrap">
                            <div class="sb-track">
                                <div class="sb-fill" style="width:@(pct)%;background:@s.Color"></div>
                            </div>
                            <div class="sb-pct">@pct%</div>
                        </div>
                    </div>
                }
                @if (sb_total == 0)
                {
                    <div style="text-align:center;color:#94a3b8;font-size:.75rem;padding:20px 0">No data available</div>
                }
            </div>
        </div>
    </div>

        <div class="sec-label">Faults by Platform &amp; Age Group</div>
    <div class="mx-wrap">
        <table class="mx-table">
            <thead>
                <tr>
                    <th class="th-age">Age Group</th>
                    <th class="th-cea">CEA</th>
                    <th class="th-msan">MSAN</th>
                    <th class="th-slbn">SLBN</th>
                    <th class="th-total">Total</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < ageLabels.Length; i++)
                {
                    <tr>
                        <td class="fw-bold">@ageLabels[i]</td>
                        <td>@ceaAge[i]</td>
                        <td>@msanAge[i]</td>
                        <td>@slbnAge[i]</td>
                        <td class="fw-bold">@ageTotals[i]</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td class="fw-bold">Total</td>
                    <td>@ceaAge.Sum()</td>
                    <td>@msanAge.Sum()</td>
                    <td>@slbnAge.Sum()</td>
                    <td class="fw-bold">@ageTotals.Sum()</td>
                </tr>
            </tfoot>
        </table>
    </div>

</div>

<div id="regionTooltip"></div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const chartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartPayload));
        const htmlEscapeMap = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
        const escapeHtml = value => String(value).replace(/[&<>"']/g, character => htmlEscapeMap[character]);

        if (window.Chart) {
            Chart.defaults.font.family = "'Segoe UI', system-ui, sans-serif";
            Chart.defaults.font.size   = 11;
            Chart.defaults.color       = '#475569';

            const platformColors = ['#00C2FF', '#00D48C', '#1A56DB'];
            const ageColors      = ['#00C2FF', '#2ECC71', '#F59E0B', '#F43F5E'];

            const sharedLegend = { position: 'bottom', labels: { boxWidth: 11, padding: 8, usePointStyle: true } };
            const sharedScaleY = { beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(0,0,0,.05)' } };

            new Chart(document.getElementById('platformPieChart'), {
                type: 'doughnut',
                data: {
                    labels: chartData.platformLabels,
                    datasets: [{ data: chartData.platformData, backgroundColor: platformColors, borderWidth: 2, borderColor: '#fff', hoverOffset: 6 }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false, cutout: '62%',
                    plugins: { legend: sharedLegend }
                }
            });

            new Chart(document.getElementById('agePieChart'), {
                type: 'doughnut',
                data: {
                    labels: chartData.ageLabels,
                    datasets: [{ data: chartData.ageData, backgroundColor: ageColors, borderWidth: 2, borderColor: '#fff', hoverOffset: 6 }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false, cutout: '62%',
                    plugins: { legend: sharedLegend }
                }
            });

            new Chart(document.getElementById('platformAgeBarChart'), {
                type: 'bar',
                data: {
                    labels: chartData.ageLabels,
                    datasets: [
                        { label: 'CEA',  data: chartData.ceaAge,  backgroundColor: '#00C2FF', borderRadius: 5 },
                        { label: 'MSAN', data: chartData.msanAge, backgroundColor: '#00D48C', borderRadius: 5 },
                        { label: 'SLBN', data: chartData.slbnAge, backgroundColor: '#1A56DB', borderRadius: 5 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    scales: { y: sharedScaleY },
                    plugins: { legend: sharedLegend }
                }
            });

            new Chart(document.getElementById('regionBarChart'), {
                type: 'bar',
                data: {
                    labels: chartData.regionLabels,
                    datasets: [{
                        label: 'Total Faults',
                        data: chartData.regionData,
                        backgroundColor: chartData.regionData.map((_, i) => {
                            const alpha = Math.min(1, 0.90 - i * 0.06);
                            return `rgba(26,86,219,${alpha})`;
                        }),
                        hoverBackgroundColor: chartData.regionData.map(() => '#00C2FF'),
                        borderRadius: { topRight: 6, bottomRight: 6 },
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',
                    animation: { duration: 700, easing: 'easeOutQuart' },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { precision: 0, color: '#64748b' },
                            grid: { color: 'rgba(0,0,0,.05)' }
                        },
                        y: {
                            ticks: {
                                color: '#334155',
                                font: { weight: '600', size: 11 }
                            },
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            enabled: false,          // disable default tooltip
                            external: function(context) {
                                const tooltipEl = document.getElementById('regionTooltip');
                                if (!tooltipEl) return;

                                const tooltip = context.tooltip;
                                if (tooltip.opacity === 0) {
                                    tooltipEl.style.opacity = '0';
                                    tooltipEl.style.pointerEvents = 'none';
                                    return;
                                }

                                const idx    = tooltip.dataPoints[0].dataIndex;
                                const total  = chartData.regionData[idx];
                                const cea    = chartData.regionCea[idx];
                                const msan   = chartData.regionMsan[idx];
                                const slbn   = chartData.regionSlbn[idx];
                                const gt7d   = chartData.regionGt7d[idx];
                                const lt1d   = chartData.regionLt1d[idx];
                                const region = chartData.regionLabels[idx];
                                const districts = (chartData.regionDistricts[idx] || [])
                                    .map(escapeHtml)
                                    .join(', ');
                                const pct    = t => total > 0 ? Math.round(t / total * 100) : 0;

                                tooltipEl.innerHTML = `
                                    <div class="rtt-header">
                                        <span class="rtt-region">${region}</span>
                                        <span class="rtt-total">${total} faults</span>
                                    </div>
                                    <div class="rtt-row">
                                        <span class="rtt-dot" style="background:#00C2FF"></span>
                                        <span class="rtt-lbl">CEA</span>
                                        <span class="rtt-bar-wrap"><span class="rtt-bar" style="width:${pct(cea)}%;background:#00C2FF"></span></span>
                                        <span class="rtt-val">${cea}</span>
                                    </div>
                                    <div class="rtt-row">
                                        <span class="rtt-dot" style="background:#00D48C"></span>
                                        <span class="rtt-lbl">MSAN</span>
                                        <span class="rtt-bar-wrap"><span class="rtt-bar" style="width:${pct(msan)}%;background:#00D48C"></span></span>
                                        <span class="rtt-val">${msan}</span>
                                    </div>
                                    <div class="rtt-row">
                                        <span class="rtt-dot" style="background:#1A56DB"></span>
                                        <span class="rtt-lbl">SLBN</span>
                                        <span class="rtt-bar-wrap"><span class="rtt-bar" style="width:${pct(slbn)}%;background:#1A56DB"></span></span>
                                        <span class="rtt-val">${slbn}</span>
                                    </div>
                                    <div class="rtt-divider"></div>
                                    <div>
                                        <span class="rtt-district-label">Districts</span>
                                        <span class="rtt-district-list">${districts || 'None recorded'}</span>
                                    </div>
                                    <div class="rtt-divider"></div>
                                    <div class="rtt-row rtt-row-sm">
                                        <span class="rtt-badge rtt-new">&lt;1 Day: ${lt1d}</span>
                                        <span class="rtt-badge rtt-stalled">&gt;7 Days: ${gt7d}</span>
                                    </div>`;

                                const canvas   = context.chart.canvas;
                                const rect     = canvas.getBoundingClientRect();
                                const scrollX  = window.scrollX || window.pageXOffset;
                                const scrollY  = window.scrollY || window.pageYOffset;
                                const tW       = tooltipEl.offsetWidth  || 220;
                                const tH       = tooltipEl.offsetHeight || 160;

                                let left = rect.left + scrollX + tooltip.caretX + 12;
                                let top  = rect.top  + scrollY + tooltip.caretY - tH / 2;

                                if (left + tW > window.innerWidth + scrollX - 8)
                                    left = rect.left + scrollX + tooltip.caretX - tW - 12;
                                if (top < scrollY + 4) top = scrollY + 4;

                                tooltipEl.style.left    = left + 'px';
                                tooltipEl.style.top     = top  + 'px';
                                tooltipEl.style.opacity = '1';
                                tooltipEl.style.pointerEvents = 'none';
                            }
                        }
                    }
                }
            });

            new Chart(document.getElementById('regionPlatformBarChart'), {
                type: 'bar',
                data: {
                    labels: chartData.regionLabels,
                    datasets: [
                        { label: 'CEA', data: chartData.regionCea, backgroundColor: '#00C2FF', borderRadius: 4 },
                        { label: 'MSAN', data: chartData.regionMsan, backgroundColor: '#00D48C', borderRadius: 4 },
                        { label: 'SLBN', data: chartData.regionSlbn, backgroundColor: '#1A56DB', borderRadius: 4 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',
                    scales: {
                        x: {
                            stacked: true,
                            beginAtZero: true,
                            ticks: { precision: 0, color: '#64748b' },
                            grid: { color: 'rgba(0,0,0,.05)' }
                        },
                        y: {
                            stacked: true,
                            ticks: { color: '#334155', font: { weight: '600', size: 11 } },
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: sharedLegend,
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            callbacks: {
                                footer: items => `Total faults: ${items.reduce((total, item) => total + item.parsed.x, 0)}`
                            }
                        }
                    }
                }
            });
        }
    </script>
}
