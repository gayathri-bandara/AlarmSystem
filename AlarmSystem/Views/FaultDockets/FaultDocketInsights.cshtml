  --heat-zero:rgba(59,130,246,.08);
  --heat-on-strong:#ffffff;
  --wst-assigned-fg:#0c5c52;
  --wst-assigned-bg:#d4f5ef;
  --wst-progress-fg:#2a3d8f;
  --wst-progress-bg:#dde4fc;
}
@@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0c1220; --surface:#141c2f; --surface-2:#1b2540; --line:#27324f;
