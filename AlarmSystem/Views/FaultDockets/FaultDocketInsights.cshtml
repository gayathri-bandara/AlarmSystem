  --chart-grid:#27324f; --chart-tick:#97a3bf;
  --tbl-head-row:#1c2850; --tbl-head-fg:#9db0d6;
  --tbl-alt:rgba(91,155,255,.05); --tbl-row-hover:rgba(91,155,255,.1);
