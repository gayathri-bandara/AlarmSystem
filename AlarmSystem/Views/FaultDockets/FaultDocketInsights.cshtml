<meta name="description" content="Fault docket insights: SLA, work group load, age bands and dockets needing attention.">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
:root{
  --bg:#f3f5f9; --surface:#ffffff; --surface-2:#eaeef5; --line:#d9dfea;
  --fg:#101a2e; --muted:#586379;
  --accent:#1558b8; --accent-soft:#dbe7fa;
  --bad:#c8302f; --bad-soft:#fbe3e2;
  --warn:#b97300; --warn-soft:#fdf0d2;
  --good:#1f8a4c; --good-soft:#dcf2e5;
  --font:'Public Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
  --mono:'JetBrains Mono',ui-monospace,Consolas,monospace;
  --dr-bg:#0e1424; --dr-surface:#151d33; --dr-surface-2:#1b2540; --dr-line:#26324f;
  --dr-fg:#e8edf8; --dr-muted:#97a3bf; --dr-accent:#5b9bff;
  --dr-bad:#ff6b66; --dr-warn:#f0b14a; --dr-good:#4cc784;
  /* ── Chart / section card tokens ── */
  --chart-bg:#eef2f9;
  --chart-card-from:#f5f9ff;
  --chart-card-to:#ffffff;
  --chart-card-border:#d9e3f3;
  --chart-grid:#d9e3f3;
  --chart-tick:#586379;
  --tbl-head-row:#eaf1fd;
  --tbl-head-fg:#3b5080;
