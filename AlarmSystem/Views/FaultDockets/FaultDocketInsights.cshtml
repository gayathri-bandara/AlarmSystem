  --bad:#ff6b66; --bad-soft:#3a1c24; --warn:#f0b14a; --warn-soft:#3a2d12;
  --good:#4cc784; --good-soft:#143427; color-scheme:dark;
  --chart-bg:#0c1220;
  --chart-card-from:#16203a; --chart-card-to:#111a31;
