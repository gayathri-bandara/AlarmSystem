@model List<AlarmSystem.Models.FaultDocket>
@{
    Layout = null;
    var rows = (Model ?? new List<AlarmSystem.Models.FaultDocket>()).Select(d => new
    {
        r = d.CLARITY_REF,
        ct = d.CUS_TYPE,
        cn = d.CUS_NAME,
        c = d.CIR_NAME,
        ctp = d.CIR_TYPE,
        rep = d.REPORTED.HasValue ? d.REPORTED.Value.ToString("dd MMM yyyy h:mm tt") : "-",
        h = d.HOURS,
        x = d.SLAExceeded,
        a = string.IsNullOrWhiteSpace(d.ACCESS_MEDIUM) ? "-" : d.ACCESS_MEDIUM,
        wo = d.WO_COUNT,
        wg = string.IsNullOrWhiteSpace(d.WORK_GROUP) ? "(none)" : d.WORK_GROUP
    }).ToList();
    var latest = Model?.Where(d => d.REPORTED.HasValue).Select(d => d.REPORTED!.Value).DefaultIfEmpty().Max();
    var detailsBase = Url.Action("Details", "FaultDetails");
    var woBase = Url.Action("Index", "WorkOrders");
    var ordersUrl = Url.Action("InsightsOrders", "FaultDockets");
    var loadError = ViewBag.LoadError as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
