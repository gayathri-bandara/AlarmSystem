  --chart-grid:#27324f; --chart-tick:#97a3bf;
  --tbl-head-row:#1c2850; --tbl-head-fg:#9db0d6;
  --tbl-alt:rgba(91,155,255,.05); --tbl-row-hover:rgba(91,155,255,.1);
  --heat-zero:rgba(232,237,248,.06); --heat-on-strong:#0b1220;
  --wst-assigned-fg:#7eecd9; --wst-assigned-bg:#163a34;
  --wst-progress-fg:#b4c3ff; --wst-progress-bg:#1a2450;
  --tbl-head-from:#1a2540; --tbl-head-to:#0f2a28;}}
:root[data-theme="dark"]{
  --bg:#0c1220; --surface:#141c2f; --surface-2:#1b2540; --line:#27324f;
  --fg:#e8edf8; --muted:#97a3bf; --accent:#5b9bff; --accent-soft:#1c2f55;
  --bad:#ff6b66; --bad-soft:#3a1c24; --warn:#f0b14a; --warn-soft:#3a2d12;
